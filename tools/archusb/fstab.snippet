# Lands at: /etc/fstab   (this is the whole file, not a fragment to append)
#
# ADAPTED from the Ventoy-era fstab. Exactly one line changed.
#
# The / and /home lines are BYTE FOR BYTE the originals, including their
# UUIDs, and that is the point of the restore procedure: the new logical
# volumes are created with "mkfs.ext4 -U <old uuid>", so these two lines need
# no edit at all. If you ever rebuild without preserving the UUIDs, these are
# the two lines to fix, and nothing else here.
#
# The /boot line is REPLACED by the /efi line. /boot was the FAT32 ARCHBOOT
# partition; there is no such partition on a falcon stick. Its replacement is
# p3, the LUKS2 UKI shelf, opened by /etc/crypttab as "cryptefi" and mounted
# at /efi. Everything that made the old line look odd - fmask, dmask, codepage,
# iocharset, shortname, errors=remount-ro - was vfat plumbing and is simply
# gone. So is umask=0077: ext4 has real ownership, and mkstick already wrote
# the MOK private key there at 0600.
#
# commit=5 carries over to /efi for the same reason it is on / and /home: this
# stick loses power uncleanly about half the time, and 15 seconds of loss
# window beats 120. nofail is new and deliberate - a p3 that will not open
# must not be able to hold up a boot that has already succeeded without it.
#
# Still no swap line. genfstab reads /proc/swaps through the bind mount and
# picks up the HOST's swap, which does not exist on the stick and stalls boot
# waiting for a device that will never appear. If you regenerate this file,
# delete the swap line again:
#     sed -i '/[[:space:]]swap[[:space:]]/d' /mnt/target/etc/fstab
#
# stripe=8191 is an ext4 allocation hint that genfstab picked up from the old
# logical volumes. It is a hint, not a correctness matter, but check it rather
# than assume: "tune2fs -l /dev/vgusb/root | grep -i stripe" after mkfs, and
# make these lines agree with what mkfs computed for the new geometry.

# Static information about the filesystems.
# See fstab(5) for details.

# <file system> <dir> <type> <options> <dump> <pass>
# /dev/mapper/vgusb-root LABEL=USBROOT
UUID=13faf1a5-d8b7-429f-86ac-b4c9e9b46795	/         	ext4      	rw,noatime,commit=5,stripe=8191	0 1

# /dev/mapper/vgusb-home LABEL=USBHOME
UUID=4c712605-d751-4d13-bcf6-3bb106059cea	/home     	ext4      	rw,noatime,commit=5,stripe=8191	0 2

# p3, the falcon UKI shelf: LUKS2 + ext4, LABEL=FALCON-UKI.
# Opened as /dev/mapper/cryptefi by /etc/crypttab; systemd's fstab and
# cryptsetup generators order this mount after that unit on their own, so no
# x-systemd.requires= is needed here.
/dev/mapper/cryptefi	/efi      	ext4      	rw,noatime,commit=5,nofail	0 2

# /dev/mapper/vg0-swap LABEL=SWAP
