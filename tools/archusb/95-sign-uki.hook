# Lands at: /etc/pacman.d/hooks/95-sign-uki.hook   (mode 0644)
#
# ADAPTED from the Ventoy-era hook. Only the Description line changed, from
# "Secure Boot db key" to "falcon MOK key". Every [Trigger] below is byte for
# byte the original's, and that is deliberate: the triggers mirror
# 90-mkinitcpio-install.hook exactly, and they were re-checked against the
# copy in the backup's /usr/share/libalpm/hooks/90-mkinitcpio-install.hook
# while adapting this. They still match.
#
# Re-sign the UKI after ANY mkinitcpio rebuild.
#
# These triggers deliberately mirror 90-mkinitcpio-install.hook exactly. An
# earlier version keyed on package names (linux, systemd, ucode) and silently
# missed rebuilds caused by path triggers -- e.g. installing wireless-regdb
# writes usr/lib/firmware/*, which regenerates the UKI. The result was an
# unsigned UKI that still booted (Secure Boot was off on that machine) and
# would have failed on a machine where it is on.
#
# Runs at 95 so it lands after 90-mkinitcpio-install.hook.
# sbctl's own hook cannot do this: it demands the full PK/KEK/db keystore, and
# this install now carries no db keystore at all, only the falcon MOK key on
# p3. Neutralise sbctl's hook the same way as before, or remove sbctl.

[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Operation = Remove
Target = usr/lib/initcpio/*
Target = usr/lib/firmware/*
Target = usr/lib/modules/*/extramodules/
Target = usr/src/*/dkms.conf
Target = usr/lib/systemd/systemd
Target = usr/bin/cryptsetup
Target = usr/bin/lvm

[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Target = usr/lib/modules/*/vmlinuz

[Trigger]
Type = Package
Operation = Install
Operation = Upgrade
Target = mkinitcpio
Target = mkinitcpio-git
Target = linux
Target = amd-ucode
Target = intel-ucode

[Action]
Description = Re-signing UKI with the falcon MOK key...
When = PostTransaction
Exec = /usr/local/bin/sign-uki
