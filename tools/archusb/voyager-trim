#!/bin/bash
# Lands at: /etc/initcpio/install/voyager-trim   (mode 0755)
#
# CARRIED OVER UNCHANGED from the Ventoy-era install. Not one line differs,
# and that is the finding rather than an oversight: this hook is about the
# physical stick (a SandForce SSD behind a USB-SATA bridge that under-reports
# its provisioning support) and about the device-mapper stack built in early
# userspace. Neither has anything to do with which bootloader ran first.
#
# It still matters on falcon, because p4 keeps LUKS2 -> LVM -> ext4 exactly as
# before, so sd-encrypt and lvm2 still build dm tables in the initramfs and
# those tables still cache the queue limits they see at load time.
#
# Confirmed while adapting: the rule this hook ships,
# /etc/udev/rules.d/10-voyager-gtx-trim.rules, still exists at that path in
# the backup and is restored by the rsync, so add_udev_rule still has
# something to copy. Keep the rule and this hook together; installing one
# without the other is a silent no-op.
#
# The only thing that changed around it is that there are now TWO dm-crypt
# devices on the stick, not one: p4 in the initramfs (which is what this hook
# exists for) and p3 at /efi in the real root. The p3 mapper is created long
# after udev has fixed the bridge, so it inherits correct limits with no help.

build() {
    # The discard rule has to be inside the initramfs, not just on the real
    # root. sd-encrypt and lvm2 build their device-mapper tables in early
    # userspace, and a dm table caches the stacked queue limits computed at
    # load time. If provisioning_mode is still "full" when cryptusb and the
    # LVs are created, every layer above the bridge caches discard_max_bytes=0
    # and stays that way after switch-root, even once udev fixes the bridge.
    add_udev_rule /etc/udev/rules.d/10-voyager-gtx-trim.rules
}

help() {
    cat <<HELPEOF
Enables SCSI UNMAP on the Corsair Flash Voyager GTX (1b1c:1a0e) early enough
that dm-crypt and LVM inherit discard support when they build their tables.
See the TRIM section of /usr/local/share/archusb/RUNBOOK.md.
HELPEOF
}
