#!/usr/bin/bash
# Lands at: /usr/lib/initcpio/post/zz-sign-uki   (mode 0755)
#
# CARRIED OVER UNCHANGED. It takes the UKI path from $3 and never names one
# itself, so repointing the shelf at /efi/uki needed no edit here. Shipped
# alongside the rest because without it a hand-run "mkinitcpio -P" leaves an
# UNSIGNED UKI, which is a documented trap rather than a hypothetical.
#
# Note the path: /usr/lib, not /etc, so a mkinitcpio package upgrade can
# delete it. Re-check it exists after any transaction that touches mkinitcpio,
# the same way the original did.
#
# Sign the UKI after any mkinitcpio run, including a manual "mkinitcpio -P".
#
# The pacman hook 95-sign-uki.hook only fires on package transactions, so a
# hand-run mkinitcpio produced an UNSIGNED UKI that still booted with Secure
# Boot off and would have failed with it on. Observed 2026-09-03 while adding
# fsck.repair=yes to the cmdline.
#
# The sbctl post hook beside this one bails out (it reports that the Secure
# Boot key directory does not exist) because this install carries no sbctl
# keystore at all. Named zz-* so it runs after that one.
#
# $3 is the UKI path when mkinitcpio built one; nothing to do otherwise.
UKI_FILE="$3"
[ -n "$UKI_FILE" ] && [ -f "$UKI_FILE" ] || exit 0
exec /usr/local/bin/sign-uki "$UKI_FILE"
