#!/bin/bash
# mkinitcpio install hook: make systemd-cryptsetup accept the falcon-boot
# passphrase credential as plaintext.
#
# The loader hands the p3 passphrase to the UKI as an sd-stub companion
# credential (docs/DESIGN.md Section 5.1) and sd-stub lands it at
# /.extra/credentials/cryptsetup.passphrase.cred. PID 1 files everything
# arriving by that route under /run/credentials/@encrypted/, because the ESP
# is untrusted and credentials delivered through it are expected to be
# systemd-creds blobs. systemd-cryptsetup-generator's unit says
# ImportCredential=cryptsetup.*, which therefore tries to DECRYPT our
# plaintext passphrase, fails, and kills the service at step CREDENTIALS with
# EINVAL (status 243) - before systemd-cryptsetup runs at all, so not even the
# interactive fallback prompt happens.
#
# Clearing ImportCredential and naming the file by path takes the plaintext
# route instead. Measured 2026-09-13: with this drop-in the unlock succeeds
# from the credential with no prompt; without it the unit cannot start.
#
# This lives as an install hook rather than a hand-edit of the initramfs so
# that "mkinitcpio -P" after a kernel or systemd update keeps it.

build() {
    local dir='/etc/systemd/system/systemd-cryptsetup@.service.d'

    add_dir "$dir"
    cat >"$BUILDROOT$dir/falcon-credential.conf" <<'CONF'
# Installed by the falcon-credential mkinitcpio hook. See
# /etc/initcpio/install/falcon-credential for why this is needed.
[Service]
ImportCredential=
LoadCredential=cryptsetup.passphrase:/.extra/credentials/cryptsetup.passphrase.cred
CONF
    chmod 0644 "$BUILDROOT$dir/falcon-credential.conf"
}

help() {
    cat <<'HELP'
Takes the falcon-boot passphrase credential as plaintext.

Drops a systemd-cryptsetup@.service override into the initramfs that clears
ImportCredential= and loads /.extra/credentials/cryptsetup.passphrase.cred by
path. Without it PID 1 treats the sd-stub-delivered credential as an encrypted
blob, fails to decrypt it, and the unlock unit dies before it runs.

Requires the systemd and sd-encrypt hooks. Place it after sd-encrypt.
HELP
}
