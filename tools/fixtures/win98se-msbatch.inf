; falcon-boot: Windows 98 SE Setup answers for the station rig's fixture disk
; (tools/fixtures/mk-win9x-fixture.sh). @PRODUCTKEY@ is filled in from a key
; file at install time and exists only on the install's throwaway source disk.
;
; Every section answers a page Setup would otherwise stop on. Networking is
; left out entirely (the guest has no NIC), so there is no logon dialog on
; the first boot and the desktop comes up on its own.

[BatchSetup]
Version=3.0 (32-bit)
SaveDate=09/27/26

[Version]
Signature="$CHICAGO$"
AdvancedINF=2.5

[Setup]
Express=1
InstallDir="C:\WINDOWS"
InstallType=1
ProductKey="@PRODUCTKEY@"
EBD=0
ShowEula=0
ChangeDir=0
OptionalComponents=1
Network=0
System=0
CCP=0
CleanBoot=0
Display=0
DevicePath=0
NoDirWarn=1
TimeZone="Pacific"
Uninstall=0
VRC=0
NoPrompt2Boot=1
PenWinWarning=0
Restart=1

[System]
Locale=L0409
SelectedKeyboard=KEYBOARD_00000409

[NameAndOrg]
Name="falcon"
Org="falcon"
Display=0

[OptionalComponents]
"Dial-Up Networking"=0
"Dial-Up Server"=0
"Microsoft Wallet"=0
"Online Services"=0
"Web TV for Windows"=0
"Personal Web Server"=0
"Web Publishing Wizard"=0
